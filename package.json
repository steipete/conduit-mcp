{
  "name": "@steipete/conduit-mcp",
  "version": "1.0.0",
  "description": "MCP server for rich file system ops, web content fetching (HTML/Markdown), image processing, search, diff & archives, via concise tools.",
  "keywords": [
    "filesystem",
    "image processing",
    "mcp",
    "server",
    "web content"
  ],
  "homepage": "https://github.com/steipete/conduit-mcp#readme",
  "bugs": {
    "url": "https://github.com/steipete/conduit-mcp/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steipete/conduit-mcp.git"
  },
  "bin": {
    "conduit-mcp": "./dist/src/mcp-server.js"
  },
  "files": [
    "dist/src/**/*",
    "start.sh",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "main": "dist/src/mcp-server.js",
  "scripts": {
    "build": "tsgo && tsc-alias",
    "start": "./start.sh",
    "dev": "tsx watch src/mcp-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings --import-plugin --node-plugin --vitest-plugin -A require-mock-type-parameters -A jest/no-conditional-expect src tests e2e vitest.config.ts vitest.config.e2e.ts",
    "lint:fix": "oxlint --fix --deny-warnings --import-plugin --node-plugin --vitest-plugin -A require-mock-type-parameters -A jest/no-conditional-expect src tests e2e vitest.config.ts vitest.config.e2e.ts",
    "format": "git ls-files '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' | xargs oxfmt --write",
    "format:check": "git ls-files '*.js' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.json' | xargs oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm run test && pnpm run test:e2e"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.15.2",
    "check-disk-space": "^3.4.0",
    "diff": "^9.0.0",
    "file-type": "^22.0.1",
    "fs-extra": "^11.3.4",
    "jsdom": "^29.1.0",
    "micromatch": "^4.0.8",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "tar": "^7.5.13",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^8.0.0",
    "@types/file-type": "^10.9.3",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^9.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/micromatch": "^4.0.10",
    "@types/mime": "^4.0.0",
    "@types/minimatch": "^6.0.0",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^25.6.0",
    "@types/sharp": "^0.32.0",
    "@types/tar": "^7.0.87",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "7.0.0-dev.20260427.1",
    "@vitest/coverage-v8": "^4.1.5",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
